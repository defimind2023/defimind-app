# Copy to .env and fill in. NEVER commit .env.
PORT=8787
# 127.0.0.1 unless set. A deployment sets 0.0.0.0 behind its own TLS and firewall.
HOST=127.0.0.1
# A deployment sets PUBLIC_PORT to serve the agent routes alone on PUBLIC_HOST:PUBLIC_PORT, and the
# admin and bot routes alone on HOST:PORT. Unset, HOST:PORT serves every route.
PUBLIC_PORT=
PUBLIC_HOST=0.0.0.0
LOG_LEVEL=info

# --- Solana. The keypair file is the ONLY place this key exists (later: KMS). ---
# CAIP-2 id of the cluster this guard pays on: devnet (default) or mainnet-beta.
SOLANA_CHAIN=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to the hot wallet keypair JSON. Keep it outside the repo, chmod 600. Unset, one is made once
# under KEYS_DIR (CR-019). Without SQUADS_MULTISIG the chain waits for a vault adopted in the panel.
SOLANA_HOT_WALLET_KEYPAIR=
SQUADS_MULTISIG=

# --- local development ---
# true runs offline stub chains: nothing is signed and no money moves. Never in production.
GUARD_STUB_CHAINS=false
# How often pending approvals and unused x402 approvals are expired, in milliseconds.
EXPIRY_SWEEP_MS=30000
# Requests per minute: per IP on every route, and per agent token on /v1/agent/* as well.
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_AGENT=60

# --- Base. Same rule for this key. ---
# Base is off unless BASE_CHAIN is set: eip155:84532 (Base Sepolia) or eip155:8453 (Base). Once set,
# guard-core refuses to start until every value below is filled in.
BASE_CHAIN=
BASE_RPC_URL=https://sepolia.base.org
# Path to a file holding the hot wallet's private key, 0x and 64 hex digits. Keep it outside the
# repo, chmod 600. (A raw HOT_WALLET_PRIVATE_KEY is refused at startup.)
BASE_HOT_WALLET_KEY_FILE=
# The owner's Safe, from onchain's create-safe.
SAFE_ADDRESS=
# Only until shared/addresses.ts has verified values for the chain (CR-005). Read them from Circle
# and from safe-modules-deployments, never from memory.
BASE_USDC=
BASE_ALLOWANCE_MODULE=

# --- Robinhood Chain (CR-007). Same rule for this key. ---
# Off unless ROBINHOOD_CHAIN is set: eip155:46630 (testnet) or eip155:4663 (mainnet). Its dollar is
# Paxos's USDG, and that address and the Allowance Module come from shared/addresses.ts only.
ROBINHOOD_CHAIN=
ROBINHOOD_RPC_URL=
# The owner's Safe on Robinhood Chain.
ROBINHOOD_SAFE_ADDRESS=
# Path to a file holding the hot wallet's private key, 0x and 64 hex digits. chmod 600.
ROBINHOOD_HOT_WALLET_KEY_FILE=

# --- keys and guided setup (CR-019) ---
# Every key file below that is left unset is made once here, directory 0700, files 0600. Defaults to
# keys/ next to the database. A file given in the env always wins.
KEYS_DIR=
# CR-022: an agent's own hot wallet key, instead of one made under KEYS_DIR/agents. Optional.
# AGENT_WALLET_<AGENT>_<CHAIN>_FILE=, e.g. AGENT_WALLET_FLY_AGENT_SOLANA_MAINNET_FILE=
# Issues the first passkey's enrol link from the panel; dead once a passkey exists.
SETUP_CODE=
# The https address the owner opens. On Render it defaults to RENDER_EXTERNAL_URL. PASSKEY_RP_ID and
# PASSKEY_ORIGIN default from it, and so does VAPID_SUBJECT.
PUBLIC_URL=
# false leaves /v1/admin/* unregistered, as on a host with one public listener.
ADMIN_ROUTES=true
# CR-022. With one listener (no PUBLIC_PORT) beyond loopback and the admin routes on, guard-core
# refuses to start: they would face every interface. true starts anyway, with a warning.
ALLOW_PUBLIC_ADMIN=false

# --- receipts and passkeys ---
# Path to an Ed25519 private key in PEM that signs a receipt for every executed payment. Generate it
# with: openssl genpkey -algorithm ed25519 -out receipt.pem. Keep it apart from the hot wallet keys.
RECEIPT_SIGNING_KEY_FILE=
# At or above this amount (atomic units), only the owner's passkey can approve. Enrol one first.
PASSKEY_ABOVE=
# guard-core's public address, which the passkey is bound to, e.g. guard.example.com and
# https://guard.example.com.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# CR-012. false (the default): approvals happen only in the panel, Telegram can still reject.
TELEGRAM_APPROVALS=false
# CR-012. Web Push to the panel: a P-256 private key in PEM (openssl ecparam -name prime256v1
# -genkey -noout -out vapid.pem) and a contact for the push services (PUBLIC_URL if unset).
VAPID_PRIVATE_KEY_FILE=
VAPID_SUBJECT=
# CR-014. The onchain signing page (https). With it the owner kill links each chain's kill there.
SIGN_PAGE_URL=
# CR-019. The signing page's build (pnpm --filter @defimind/onchain build:web), served at /sign.
# Defaults to packages/onchain/web/dist.
SIGN_DIR=
# The panel's static build, served at /panel. Defaults to packages/panel/dist.
PANEL_DIR=

# --- auth (SPEC: Authorization: Bearer <token>) ---
# Admin token for /v1/admin/*. Agent tokens are per-agent rows in the DB.
ADMIN_TOKEN=

# --- telegram-bot, optional (CR-017): all three or none ---
# Without them guard-core sends no webhook and has no /v1/bot/* routes; the panel's Web Push
# reaches the owner. BOT_TOKEN is the bot's token for /v1/bot/*.
BOT_TOKEN=
BOT_URL=
BOT_WEBHOOK_SECRET=

# --- database (MVP: SQLite) ---
# Fine for devnet. On mainnet it must be on a persistent volume, outside the repo and any temp
# directory, e.g. file:/var/lib/defimind/guard.db; guard-core refuses to start otherwise.
DATABASE_URL=file:./data/guard.db
# CR-024. The daily backup's hour (UTC); backups go to backups/ beside the database, newest 14 kept.
BACKUP_HOUR_UTC=3
# Optional encrypted off-site copy: an S3-compatible bucket, https://<endpoint>/<bucket>[/<prefix>].
# With it, the two keys and BACKUP_ENCRYPTION_KEY (openssl rand -hex 32) are required. Secrets.
BACKUP_BUCKET_URL=
BACKUP_REGION=auto
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=

# Only behind a proxy that sets Fly-Client-IP and drops the client's own (Fly, or deploy/Caddyfile).
TRUST_FLY_CLIENT_IP=false
# Only behind a proxy that appends the client's address to X-Forwarded-For (Render). The last hop is
# used; the ones before it are whatever the client sent. Not with TRUST_FLY_CLIENT_IP.
TRUST_FORWARDED_FOR=false
